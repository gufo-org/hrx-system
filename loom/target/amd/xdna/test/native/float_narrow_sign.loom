// Negative lanes must retain their sign through saturating packet narrowing.
aie2p.target<array> @npu

pipeline.def<kernel> public retain target(@npu) @float_narrow_sign() run(%input_arg: buffer, %output_arg: buffer) {
  %input, %output = buffer.assume.alignment %input_arg, %output_arg {minimum_alignment = 64} : buffer, buffer
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %origin = index.constant 0 : offset
  %input_bytes = index.constant 64 : offset
  %output_bytes = index.constant 32 : offset
  %capacity = index.constant 1 : index
  %input_storage = buffer.alloca<workgroup> pool(%memory) align(64) %input_bytes : buffer
  %input_slots = buffer.view %input_storage[%origin] : buffer -> view<1x16xf32>
  %input_records = channel.bind<fifo> %input_slots, %capacity : view<1x16xf32>, index -> channel<tile<16xf32>>
  %output_storage = buffer.alloca<workgroup> pool(%memory) align(64) %output_bytes : buffer
  %output_slots = buffer.view %output_storage[%origin] : buffer -> view<1x16xi16>
  %output_records = channel.bind<fifo> %output_slots, %capacity : view<1x16xi16>, index -> channel<tile<16xi16>>

  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %external = buffer.view %input[%origin] : buffer -> view<16xf32>
    %write, %destination = channel.reserve %input_records : channel<tile<16xf32>> -> (write<tile<16xf32>>, view<16xf32>)
    %copy = kernel.async.copy %external to %destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<16xf32> to view<16xf32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    channel.publish %write : write<tile<16xf32>>
  }

  pipeline.strand workers([0, 4], [1, 1], [1, 1]) {
    %read, %source = channel.acquire %output_records : channel<tile<16xi16>> -> (read<tile<16xi16>>, view<16xi16>)
    %external = buffer.view %output[%origin] : buffer -> view<16xi16>
    %copy = kernel.async.copy %source to %external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<16xi16> to view<16xi16> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<16xi16>>
  }

  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %read, %source = channel.acquire %input_records : channel<tile<16xf32>> -> (read<tile<16xf32>>, view<16xf32>)
    %write, %destination = channel.reserve %output_records : channel<tile<16xi16>> -> (write<tile<16xi16>>, view<16xi16>)
    %values = vector.load %source[0] : view<16xf32> -> vector<16xf32>
    %half = vector.fptrunc %values : vector<16xf32> to vector<16xf16>
    %bits = vector.bitcast %half : vector<16xf16> to vector<16xi16>
    vector.store %bits, %destination[0] : vector<16xi16>, view<16xi16>
    channel.publish %write : write<tile<16xi16>>
    channel.release %read : read<tile<16xf32>>
  }
}

// The scalar conversion uses an independent VM lowering as the native oracle.
func.def @float_narrow_sign_reference(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<16xf32>
  %destination = buffer.view %output[%origin] : buffer -> view<16xi16>
  %begin = index.constant 0 : index
  %end = index.constant 16 : index
  %step = index.constant 1 : index
  scf.for %position = [%begin to %end step %step] {
    %value = view.load %source[%position] : view<16xf32> -> f32
    %half = scalar.fptrunc %value : f32 to f16
    %bits = scalar.bitcast %half : f16 to i16
    view.store %bits, %destination[%position] : i16, view<16xi16>
  }
  func.return
}

check.scenario public @signed_narrowing {
  check.trial[3](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-4.0 to 4.0) : tensor<16xf32>
    %output = check.generate.fill value(23130) : tensor<16xi16>
    check.compare<@float_narrow_sign, @float_narrow_sign_reference>(%input, %output) : (tensor<16xf32>, tensor<16xi16>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<16xf32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<16xi16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(-0.0) : tensor<16xf32>
    %output = check.generate.fill value(23130) : tensor<16xi16>
    check.compare<@float_narrow_sign, @float_narrow_sign_reference>(%input, %output) : (tensor<16xf32>, tensor<16xi16>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<16xf32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<16xi16>
    }
  }
  check.return
}

