  %91 = vge.u32x16.el.low32 %35, %90
  %92 = predicate.complete.zero.high32 %91, 0
  %93 = vsel.16.mask64 %85, %88, %92
  %94 = mov.shift 18
  %95 = vsrs.2x.b-to-w.unsigned %45, %94
  %96 = concat(%95, %44) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %97 = mov.i32 905969664
  %98 = vbcst.32 %97
  %99 = vge.u32x16.el.low32 %35, %98
  %100 = predicate.complete.zero.high32 %99, 0
  %101 = vsel.16.mask64 %93, %96, %100
  %102 = mov.shift 17
  %103 = vsrs.2x.b-to-w.unsigned %45, %102
  %104 = concat(%103, %44) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %105 = mov.i32 914358272
