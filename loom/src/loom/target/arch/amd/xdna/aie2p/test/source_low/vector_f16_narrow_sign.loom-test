  %139 = mov.shift 0
  %140 = vups.2x.x-to-c.unsigned %42, %139
  %141 = vsrs.2x.c-to-x.unsigned %140, %39
  set.saturation 1
  set.rounding 12
  set.srs-mode 0
  %142 = slice %141[1] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %143 = vmov.vector512.to.accumulator512 %141
  %144 = vsrs.2x.b-to-w.unsigned %143, %139
  %145 = concat(%144, %142) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %146 = vbor %145, %24
  %147 = vbor %146, %22
  %148 = vge.u32x16.el.low32 %42, %28
  %149 = predicate.complete.zero.high32 %148, 0
  %150 = vsel.16.mask64 %22, %147, %149
