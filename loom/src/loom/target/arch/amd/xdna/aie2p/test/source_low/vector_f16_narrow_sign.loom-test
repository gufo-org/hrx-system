  %51 = vge.u32x16.el.low32 %35, %50
  %52 = predicate.complete.zero.high32 %51, 0
  %53 = vsel.16.mask64 %26, %48, %52
  %54 = mov.shift 23
  %55 = vsrs.2x.b-to-w.unsigned %45, %54
  %56 = concat(%55, %44) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
