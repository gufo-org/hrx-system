  %116 = vsel.16.mask64 %109, %111, %115
  %117 = mov.shift 15
  %118 = vsrs.2x.b-to-w.unsigned %45, %117
  %119 = concat(%118, %44) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %120 = mov.i32 931135488
  %121 = vbcst.32 %120
  %122 = vge.u32x16.el.low32 %35, %121
  %123 = predicate.complete.zero.high32 %122, 0
  %124 = vsel.16.mask64 %116, %119, %123
  %125 = mov.shift 14
  %126 = vsrs.2x.b-to-w.unsigned %45, %125
  %127 = concat(%126, %44) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %130 = vge.u32x16.el.low32 %35, %14
  %131 = predicate.complete.zero.high32 %130, 0
  %132 = vsel.16.mask64 %124, %127, %131
  %133 = vge.u32x16.el.low32 %35, %16
