  %108 = predicate.complete.zero.high32 %107, 0
  %109 = vsel.16.mask64 %101, %104, %108
  %110 = vsrs.2x.b-to-w.unsigned %45, %32
  %111 = concat(%110, %44) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %112 = mov.i32 922746880
