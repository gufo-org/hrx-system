// RUN: emit source-low output=low

// The isolated F32 sign is a negative signed accumulator. Narrow it without
// saturation so it remains 0x8000, then restore saturation for magnitudes.
aie2p.target<core> @target

func.def target(@target) @narrow(%input: vector<16xf32>) -> (vector<16xf16>) {
  %result = vector.fptrunc %input : vector<16xf32> to vector<16xf16>
  func.return %result : vector<16xf16>
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @narrow(%input: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  set.saturation 1
  set.rounding 12
  set.srs-mode 0
  %5 = mov.i32 -2147483648
  %6 = vbcst.32 %5
