  %31 = vmov.vector512.to.accumulator512 %29
  set.saturation 0
  %32 = mov.shift 16
  %33 = vsrs.2x.b-to-w.unsigned %31, %32
  %34 = concat(%33, %30) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  set.saturation 1
  %35 = vband %input, %8
  %36 = vsub.32 %35, %14
  %37 = slice %36[1] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %38 = vmov.vector512.to.accumulator512 %36
  %39 = mov.shift 13
  %40 = vsrs.2x.b-to-w.unsigned %38, %39
  %41 = concat(%40, %37) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %42 = vband %35, %10
  %43 = vbor %42, %12
  %44 = slice %43[1] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %45 = vmov.vector512.to.accumulator512 %43
  %46 = mov.shift 24
  %47 = vsrs.2x.b-to-w.unsigned %45, %46
  %48 = concat(%47, %44) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %49 = mov.i32 855638016
